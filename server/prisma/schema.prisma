generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String    @map("password_hash")
  displayName              String    @map("display_name")
  avatarUrl                String?   @map("avatar_url")
  emailVerified            Boolean   @default(false) @map("email_verified")
  emailVerificationToken   String?   @map("email_verification_token")
  passwordResetToken       String?   @map("password_reset_token")
  passwordResetExpiresAt   DateTime? @map("password_reset_expires_at")
  preferredStreamingProviderIds Int[]  @default([]) @map("preferred_streaming_provider_ids")
  letterboxdUsername       String?   @map("letterboxd_username")
  createdAt                DateTime  @default(now()) @map("created_at")

  userMovies        UserMovie[]
  soloSessions      SwipeSession[]
  groupSessionsAsP2 SwipeSession[] @relation("SessionUser2")
  friendshipsSent      Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]    @relation("FriendshipAddressee")
  invitesSent          SessionInvite[] @relation("SessionInviteFrom")
  invitesReceived      SessionInvite[] @relation("SessionInviteTo")

  @@index([passwordResetToken])
  @@index([emailVerificationToken])
  @@map("users")
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String   @map("requester_id")
  addresseeId String   @map("addressee_id")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

model SessionInvite {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  session  SwipeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromUser User         @relation("SessionInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User         @relation("SessionInviteTo",   fields: [toUserId],   references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([sessionId])
  @@map("session_invites")
}

model Movie {
  id                 String  @id @default(uuid())
  tmdbId             Int     @unique @map("tmdb_id")
  title              String
  year               Int?
  posterUrl          String? @map("poster_url")
  overview           String?
  genres             Json    @default("[]")
  director           String?
  cast               Json    @default("[]")
  runtime            Int?
  tmdbRating         Float?  @map("tmdb_rating")
  streamingProviders Json    @default("[]") @map("streaming_providers")

  userMovies    UserMovie[]
  sessionMovies SessionMovie[]
  matches       Match[]

  @@map("movies")
}

model UserMovie {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  movieId     String   @map("movie_id")
  source      String   @default("manual")
  onWatchlist Boolean  @default(false) @map("on_watchlist")
  watched     Boolean  @default(false)
  userRating  Float?   @map("user_rating")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id])

  @@unique([userId, movieId])
  @@map("user_movies")
}

model SwipeSession {
  id        String   @id @default(uuid())
  type      String   @default("group")
  userId    String?  @map("user_id")
  user2Id   String?  @map("user_2_id")
  guestId   String?  @map("guest_id")
  guestName String?  @map("guest_name")
  shortCode String?  @unique @map("short_code")
  status    String   @default("waiting")
  filters   Json     @default("{}")
  batchSize Int?     @map("batch_size")
  createdAt DateTime @default(now()) @map("created_at")

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  user2   User?          @relation("SessionUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  movies  SessionMovie[]
  matches Match[]
  invites SessionInvite[]

  @@map("swipe_sessions")
}

model SessionMovie {
  id        String  @id @default(uuid())
  sessionId String  @map("session_id")
  movieId   String  @map("movie_id")
  user1Swipe String? @map("user_1_swipe")
  user2Swipe String? @map("user_2_swipe")

  session SwipeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movie   Movie        @relation(fields: [movieId], references: [id])

  @@unique([sessionId, movieId])
  @@map("session_movies")
}

model Match {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  movieId     String   @map("movie_id")
  resolved    Boolean  @default(false)
  watched     Boolean  @default(false)
  watchedAt   DateTime? @map("watched_at")
  user1Rating Float?   @map("user_1_rating")
  user2Rating Float?   @map("user_2_rating")

  session SwipeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movie   Movie        @relation(fields: [movieId], references: [id])

  @@unique([sessionId, movieId])
  @@map("matches")
}

