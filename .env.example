# Server
DATABASE_URL=postgresql://user:password@localhost:5432/moviepicker
JWT_SECRET=your-secret-key-at-least-32-characters
TMDB_API_KEY=your-tmdb-api-key
# Production: CLIENT_URL=https://matchsticked.com
CLIENT_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# Email (Resend). Omit in dev to log magic-link emails to stdout.
RESEND_API_KEY=
EMAIL_FROM=Matchsticked <no-reply@matchsticked.com>

# Letterboxd scrape proxy (optional). Required on Railway/any datacenter host —
# Letterboxd blocks direct requests from those IPs. Prefers ScrapingAnt if both
# are set. ScrapingAnt free tier: 10k credits/month (~100 imports). ScraperAPI
# retained as a fallback toggle.
SCRAPINGANT_API_KEY=
SCRAPER_API_KEY=

# Apple Sign In (mobile). The audience claim Apple's identity tokens carry —
# must match the iOS bundle id. Override only if you ship a different bundle.
APPLE_BUNDLE_ID=com.matchsticked.mobile

# Comma-separated usernames allowed to read /api/feedback. Empty = nobody.
ADMIN_USERNAMES=

# Client
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
