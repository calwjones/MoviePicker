# Server
DATABASE_URL=postgresql://user:password@localhost:5432/moviepicker
JWT_SECRET=your-secret-key-at-least-32-characters
TMDB_API_KEY=your-tmdb-api-key
# Production: CLIENT_URL=https://matchsticked.com
CLIENT_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# Email (Resend). Omit in dev to log magic-link emails to stdout.
RESEND_API_KEY=
EMAIL_FROM=Matchsticked <no-reply@matchsticked.com>

# Letterboxd scrape proxy (optional). When set, username imports route
# through ScraperAPI to dodge datacenter IP blocks on Railway.
SCRAPER_API_KEY=

# Client
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
